# Local test of the cloud configuration (never commit the real values)
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql://catalog:PASSWORD@localhost:5432/catalog
STORAGE_BACKEND=local            # drive on Cloud Run
OWNER_USERNAME=admin
OWNER_PASSWORD=change-me-to-a-strong-password   # used once, only when there are no users yet
# Set to the canonical HTTPS address before enabling customer portal links in production
# PUBLIC_BASE_URL=https://catalog.example.com
# Google (only with STORAGE_BACKEND=drive / Sheets sync)
# GOOGLE_OAUTH_TOKEN_JSON={"token": ...}   <- from scripts/get_token.py
# DRIVE_ROOT_FOLDER_ID=            <- optional: use an existing folder / Shared Drive
